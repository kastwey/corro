{
  "format": "corro/v1",
  "gameType": "shedding",
  "engineVersion": "^1.0",
  "id": "four-colours",
  "name": {
    "es": "Cuatro Colores",
    "en": "Four Colours"
  },
  "author": "kastwey",
  "version": "0.1.0",
  "locales": [
    "en",
    "es"
  ],
  "players": {
    "min": 2,
    "max": 5
  },
  "sheddingRules": {
    "handSize": 7,
    "targetScore": 500,
    "drawnCardPlayable": true,
    "wildDrawRequiresNoMatch": true
  },
  "ruleGroups": [
    {
      "id": "shedding",
      "nameKey": "rules.group.shedding"
    }
  ],
  "houseRules": [
    {
      "id": "sheddingEndMode",
      "group": "shedding",
      "type": "choice",
      "default": "score",
      "options": [
        {
          "id": "score",
          "nameKey": "rules.sheddingEndModeScore"
        },
        {
          "id": "rounds",
          "nameKey": "rules.sheddingEndModeRounds"
        }
      ],
      "editableByHost": true,
      "nameKey": "rules.sheddingEndMode"
    },
    {
      "id": "sheddingTargetScore",
      "group": "shedding",
      "type": "number",
      "default": 500,
      "min": 1,
      "step": 1,
      "editableByHost": true,
      "nameKey": "rules.sheddingTargetScore",
      "showWhen": {
        "rule": "sheddingEndMode",
        "is": "score"
      }
    },
    {
      "id": "sheddingRounds",
      "group": "shedding",
      "type": "number",
      "default": 15,
      "min": 1,
      "step": 1,
      "editableByHost": true,
      "nameKey": "rules.sheddingRounds",
      "showWhen": {
        "rule": "sheddingEndMode",
        "is": "rounds"
      }
    },
    {
      "id": "sheddingScoring",
      "group": "shedding",
      "type": "choice",
      "default": "collect",
      "options": [
        {
          "id": "collect",
          "nameKey": "rules.sheddingScoringCollect"
        },
        {
          "id": "penalty",
          "nameKey": "rules.sheddingScoringPenalty"
        }
      ],
      "editableByHost": true,
      "nameKey": "rules.sheddingScoring"
    },
    {
      "id": "sheddingAllowDoubles",
      "group": "shedding",
      "type": "toggle",
      "default": false,
      "editableByHost": true,
      "nameKey": "rules.sheddingAllowDoubles"
    },
    {
      "id": "sheddingStacking",
      "group": "shedding",
      "type": "choice",
      "default": "none",
      "options": [
        {
          "id": "none",
          "nameKey": "rules.sheddingStackingNone"
        },
        {
          "id": "sameType",
          "nameKey": "rules.sheddingStackingSameType"
        },
        {
          "id": "cross",
          "nameKey": "rules.sheddingStackingCross"
        }
      ],
      "editableByHost": true,
      "nameKey": "rules.sheddingStacking"
    },
    {
      "id": "sheddingLastCardCall",
      "group": "shedding",
      "type": "toggle",
      "default": false,
      "editableByHost": true,
      "nameKey": "rules.sheddingLastCardCall"
    }
  ],
  "tokens": [
    {
      "id": "circle",
      "nameKey": "tokens.circle"
    },
    {
      "id": "square",
      "nameKey": "tokens.square"
    },
    {
      "id": "triangle",
      "nameKey": "tokens.triangle"
    },
    {
      "id": "star",
      "nameKey": "tokens.star"
    },
    {
      "id": "diamond",
      "nameKey": "tokens.diamond"
    }
  ],
  "botNames": [
    "bots.rombo",
    "bots.circulo",
    "bots.esquina",
    "bots.arcoiris",
    "bots.simetria",
    "bots.descarte"
  ]
}
